{
  "manifest_version": 3,
  "name": "Parally",
  "version": "0.5.0",
  "description": "Send browser downloads to Parally. Click the toolbar button to turn it off or on.",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "permissions": ["contextMenus", "cookies", "downloads", "nativeMessaging", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" }
}
